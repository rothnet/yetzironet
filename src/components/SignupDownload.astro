---
interface Props { slug: string; label: string; title: string }
const { slug, label, title } = Astro.props;
---
<dialog class="signup" id="signup-dialog" aria-labelledby="signup-title" data-slug={slug}>
  <form method="dialog" class="signup-close"><button aria-label="סגירה" class="x">×</button></form>
  <div class="signup-body">
    <h2 id="signup-title">{label}</h2>
    <p>השאירו פרטים ותקבלו מיד את הקובץ של "{title}" להורדה.</p>
    <form id="signup-form" novalidate>
      <label>שם<input name="name" autocomplete="name" required /></label>
      <label>אימייל<input name="email" type="email" autocomplete="email" required /></label>
      <label>טלפון (לא חובה)<input name="phone" type="tel" autocomplete="tel" /></label>
      <label class="hp" aria-hidden="true">אתר<input name="website" tabindex="-1" autocomplete="off" /></label>
      <label class="check"><input name="updates" type="checkbox" checked /> אשמח לקבל עדכונים על יצירות חדשות</label>
      <p class="signup-msg" role="status" aria-live="polite"></p>
      <button class="pill" type="submit">שליחה וקבלת הקובץ</button>
    </form>
    <div class="signup-done" hidden>
      <p>תודה! הקובץ מוכן:</p>
      <a class="pill" id="signup-file" href="#" download target="_blank" rel="noopener">הורדת הקובץ</a>
    </div>
  </div>
</dialog>

<script>
  const dlg = document.getElementById('signup-dialog') as HTMLDialogElement;
  const form = document.getElementById('signup-form') as HTMLFormElement;
  const msg = dlg.querySelector('.signup-msg') as HTMLElement;
  document.querySelectorAll<HTMLElement>('[data-open-signup]').forEach((b) =>
    b.addEventListener('click', () => { dlg.showModal(); (form.elements.namedItem('name') as HTMLInputElement).focus(); })
  );
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (!d.name?.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(d.email || '')) { msg.textContent = 'נא למלא שם ואימייל תקין'; return; }
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true; msg.textContent = 'שולח…';
    try {
      const r = await fetch('/api/lead', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ...d, updates: !!d.updates, slug: dlg.dataset.slug }) });
      const j = await r.json();
      if (!r.ok) throw new Error(j.error || 'שגיאה');
      (document.getElementById('signup-file') as HTMLAnchorElement).href = j.file;
      form.hidden = true;
      (dlg.querySelector('.signup-done') as HTMLElement).hidden = false;
    } catch (err) {
      msg.textContent = (err as Error).message || 'משהו השתבש, נסו שוב';
    } finally { btn.disabled = false; }
  });
</script>

<style>
  .signup { border: 0; border-radius: 26px; padding: 0; width: min(460px, calc(100% - 32px)); background: var(--cream); color: var(--ink); box-shadow: 0 30px 80px rgba(0,0,0,.3); }
  .signup::backdrop { background: rgba(31, 26, 36, .55); }
  .signup-close { position: absolute; inset-inline-end: 10px; top: 10px; margin: 0; }
  .x { width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; font-size: 28px; cursor: pointer; color: var(--ink); }
  .signup-body { padding: 36px 30px 30px; }
  .signup h2 { margin: 0 0 8px; font-size: 1.6rem; font-weight: 800; line-height: 1.2; }
  .signup-body > p { margin: 0 0 18px; color: var(--ink-2); }
  #signup-form { display: grid; gap: 12px; }
  #signup-form label { display: grid; gap: 4px; font-size: .9rem; font-weight: 500; }
  #signup-form input:not([type=checkbox]) { font: inherit; min-height: 48px; border: 1.5px solid var(--line); border-radius: 12px; padding: 0 14px; background: #fff; width: 100%; }
  #signup-form .check { display: flex; gap: 8px; align-items: center; font-weight: 400; }
  .hp { position: absolute; left: -9999px; }
  .signup-msg { margin: 0; min-height: 1.2em; color: var(--pink); font-size: .9rem; }
  .signup-done { text-align: center; display: grid; gap: 12px; justify-items: center; }
</style>
