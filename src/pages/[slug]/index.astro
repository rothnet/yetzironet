---
import Base from '../../layouts/Base.astro';
import CreationCard from '../../components/CreationCard.astro';
import { creations, teaser } from '../../lib/data';

export function getStaticPaths() {
  return creations.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const idx = creations.findIndex((x) => x.id === c.id);
const more = [1, 2, 3].map((k) => creations[(idx + k) % creations.length]);
const withImg = c.steps.filter((s) => s.image).length;
---
<Base title={c.title} description={teaser(c, 155)} image={c.cover} active="gallery">
  <section class="hero creation">
    <div class="blob" style="width:480px;height:480px;background:var(--pink-soft);right:-240px;top:-180px"></div>
    <div class="wrap hero-grid">
      <div>
        <p class="crumb"><a href="/השראות-ויצירות/">השראות ויצירות</a> ›</p>
        <h1>{c.title}</h1>
        <div class="intro">{c.intro.map((p) => <p>{p}</p>)}</div>
        <div class="tags">
          <span class="tag t1">{c.steps.length} שלבים</span>
          <span class="tag t2">{c.materials.length} חומרים</span>
        </div>
      </div>
      <div class="hero-media">
        <div class="blob b2 float d2"></div>
        <div class="blob b3 float d3"></div>
        <img class="hero-photo" src={c.cover} alt={c.title} width="800" height="600" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:24px">
    <div class="wrap">
      <div class="materials">
        <div>
          <h2>{c.materialsTitle}</h2>
          {c.download && <div class="download"><a class="pill" href={c.download.file} download>{c.download.label}</a></div>}
        </div>
        <ul>{c.materials.map((m) => <li>{m}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="blob" style="width:520px;height:520px;background:var(--yellow-soft);left:-280px;top:280px"></div>
    <div class="blob" style="width:420px;height:420px;background:var(--teal-soft);right:-240px;bottom:200px"></div>
    <div class="wrap">
      <h2 class="section-title">הוראות <b>הכנה</b></h2>
      <ol class="cards three steps">
        {c.steps.map((s, i) => (
          <li class={`ccard step v${i % 4}`}>
            <div class="ccard-img">{s.image ? <img src={s.image} alt={`שלב ${i + 1}`} width="800" height="600" loading={i < 3 ? 'eager' : 'lazy'} /> : <img src={c.cover} alt="" width="800" height="600" loading="lazy" />}</div>
            <div class="ccard-panel">
              <span class="num" aria-hidden="true">{i + 1}</span>
              <span class="sr-only">שלב {i + 1}:</span>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" style="padding-top:8px">
    <div class="wrap">
      <div class="closing">
        <h2>עשו זאת <b>בעצמכם!</b></h2>
        <p>מוזמנים ליצור ולשתף אותנו – האם נהנתם? איך יצא? שלחו לנו תמונה בוואטסאפ. בהצלחה!</p>
        <p style="margin-top:22px"><a class="pill" style="background:var(--yellow);color:var(--ink)" href="https://wa.me/972527491119" target="_blank" rel="noopener">שליחת תמונה בוואטסאפ</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">עוד יצירות <b>שתאהבו</b></h2>
      <div class="cards three">{more.map((m, i) => <CreationCard c={m} v={i} />)}</div>
      <p class="more-link"><a class="pill" href="/השראות-ויצירות/">לכל היצירות</a></p>
    </div>
  </section>
</Base>
