---
import Base from '../layouts/Base.astro';
import CreationCard from '../components/CreationCard.astro';
import MiniCard from '../components/MiniCard.astro';
import { creations, href, teaser } from '../lib/data';

const featured = creations.slice(0, 4);
const latest = creations.slice(4, 10);
const story = creations.find((c) => c.slug === 'שעון-ממקשי-מקלדת') ?? creations[0];
const heroImg = '/media/2020/11/צמיד-חוטים-28-1.jpg';
---
<Base title="יצירונט" active="home" image={heroImg}>
  <section class="hero">
    <div class="blob" style="width:520px;height:520px;background:var(--cream-2);right:-220px;top:-160px"></div>
    <div class="wrap hero-grid">
      <div>
        <h1>יצירות עשה<b>זאת בעצמך!</b></h1>
        <p>המקור האולטימטיבי בשבילך לקבלת השראה יצירתית. צלול לתוך חדוות היצירה עם ההדרכות הפשוטות שלב אחר שלב. אני כאן כדי לעזור לך לייצר פרויקטים מהנים וקלים, כגון: צמידי מקרמה, שעון ממקשי מקלדת ועוד. אין צורך בניסיון – רק ההתלהבות והסקרנות שלך!</p>
        <a class="pill" href="/השראות-ויצירות/">התחילו ליצור עכשיו</a>
      </div>
      <div class="hero-media">
        <div class="blob b1"></div>
        <div class="blob b2"></div>
        <img class="hero-photo" src={heroImg} alt="צמיד מקרמה בעבודת יד" width="800" height="600" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section welcome">
    <div class="wrap">
      <svg class="squiggle" aria-hidden="true" width="120" height="14" viewBox="0 0 120 14" fill="none"><path d="M2 7c10-8 20 8 29 0s19-8 29 0 19 8 29 0 20-8 29 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
      <h2>ברוכים הבאים <b>ליצירונט!</b></h2>
      <p>אם אתם אוהבים יצירות ולהוטים ליצור יצירות מופת ייחודיות בעצמכם, הגעתם ליעד המושלם. כאן תקבלו השראה והוראות – שלב אחר שלב כדי להפוך חומרים פשוטים ליצירות מדהימות עם תוצאות יוצאות דופן.</p>
    </div>
  </section>

  <section class="section">
    <div class="blob" style="width:560px;height:560px;background:var(--pink-soft);right:-300px;top:40px"></div>
    <div class="blob" style="width:300px;height:300px;background:var(--yellow-soft);left:-120px;bottom:-40px"></div>
    <div class="wrap">
      <h2 class="section-title">השראות <b>ויצירות</b></h2>
      <div class="cards">
        {featured.map((c, i) => <CreationCard c={c} v={i} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="blob" style="width:380px;height:380px;background:var(--teal-soft);left:-200px;top:20px"></div>
    <div class="blob" style="width:300px;height:300px;background:var(--cream-2);right:-120px;bottom:-60px"></div>
    <div class="wrap">
      <h2 class="section-title">עוד <b>יצירות</b></h2>
      <div class="latest">
        {latest.map((c) => <MiniCard c={c} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="blob" style="width:340px;height:340px;background:var(--yellow);left:-180px;bottom:-80px"></div>
    <div class="wrap">
      <h2 class="section-title">היצירה <b>המומלצת</b></h2>
      <article class="story">
        <img src={story.cover} alt="" width="800" height="600" loading="lazy" />
        <div class="story-panel">
          <img src={story.steps[Math.min(9, story.steps.length - 1)].image ?? story.cover} alt="" width="800" height="600" loading="lazy" />
          <div>
            <h3>{story.title}</h3>
            <p>{teaser(story, 170)}</p>
            <a class="more" href={href(story)}>+ למדריך המלא</a>
          </div>
        </div>
      </article>
    </div>
  </section>
</Base>
