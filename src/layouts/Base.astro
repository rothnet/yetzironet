---
import '../styles/global.css';
interface Props { title: string; description?: string; image?: string; active?: 'home' | 'gallery' | null }
const { title, description = 'יצירות עשה זאת בעצמך — הדרכות מצולמות, שלב אחר שלב.', image, active = null } = Astro.props;
const full = title === 'יצירונט' ? 'יצירונט — יצירות עשה זאת בעצמך' : `${title} | יצירונט`;
const og = image ? new URL(encodeURI(image), Astro.site).href : undefined;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="canonical" href={Astro.url.href} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="he_IL" />
  {og && <meta property="og:image" content={og} />}
</head>
<body>
  <a class="skip" href="#main">דלג לתוכן</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label="יצירונט — דף הבית"><img src="/logo-wordmark.png" alt="יצירונט" width="583" height="248" /></a>
      <nav class="nav" aria-label="תפריט ראשי">
        <a href="/" aria-current={active === 'home' ? 'page' : undefined}>דף הבית</a>
        <a href="/השראות-ויצירות/" aria-current={active === 'gallery' ? 'page' : undefined}>השראות ויצירות</a>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <a class="foot-logo-link" href="/" aria-label="יצירונט — דף הבית"><img class="foot-logo" src="/logo-wordmark-light.png" alt="יצירונט" width="583" height="248" /></a>
          <p style="margin:0;color:#cbbfb1;font-size:.95rem">השראה והוראות – שלב אחר שלב, להפוך חומרים פשוטים ליצירות מדהימות.</p>
        </div>
        <div>
          <h2>ניווט</h2>
          <ul>
            <li><a href="/">דף הבית</a></li>
            <li><a href="/השראות-ויצירות/">השראות ויצירות</a></li>
            <li><a href="tel:+972527491119">052-749-1119</a></li>
            <li><a href="https://wa.me/972527491119" target="_blank" rel="noopener">וואטסאפ</a></li>
          </ul>
        </div>
        <form class="idea" id="idea-form" aria-labelledby="idea-title">
          <h2 id="idea-title">יש לכם רעיון ליצירה? כתבו לנו...</h2>
          <div class="row">
            <label>שם<input name="name" type="text" autocomplete="name" required /></label>
            <label>טלפון<input name="phone" type="tel" autocomplete="tel" /></label>
          </div>
          <label>הודעה<textarea name="message" required></textarea></label>
          <button class="pill small" type="submit">שליחה בוואטסאפ</button>
        </form>
      </div>
      <div class="foot-bottom">
        <span class="rights"><span>© {year} כל הזכויות שמורות ליצירונט</span><span class="dot" aria-hidden="true"> · </span><span>המידע לשימוש עצמי בלבד</span></span>
        <a href={`https://wa.me/972524723399?text=${encodeURIComponent("היי מוישי, הגעתי אליך מהאתר יצירונט")}`} target="_blank" rel="noopener">פיתוח ועיצוב: מוישי רוט</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var f = document.getElementById('idea-form');
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        var d = new FormData(f);
        var msg = 'שלום, יש לי רעיון ליצירה!\n' + d.get('message') + '\n\n' + d.get('name') + (d.get('phone') ? ' · ' + d.get('phone') : '');
        window.open('https://wa.me/972527491119?text=' + encodeURIComponent(msg), '_blank', 'noopener');
      });
    })();
  </script>
</body>
</html>
